{
  "name": "expo-reverse-tcp",
  "version": "0.1.0",
  "description": "Expo config plugin that runs adb reverse for configured TCP ports on local Android installs.",
  "bugs": {
    "url": "https://github.com/thejoaov/expo-android-tcp/issues"
  },
  "homepage": "https://github.com/thejoaov/expo-android-tcp#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejoaov/expo-android-tcp.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./gradle": "./dist/gradle.js",
    "./options": "./dist/options.js",
    "./*": "./*"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "bun run build",
    "release": "release-it --config ../../.release-it.json",
    "release:ci": "release-it --config ../../.release-it.json --ci",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo/config-plugins": "^54.0.4"
  },
  "peerDependencies": {
    "expo": "~54.0.33"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun-types": "^1.3.10",
    "release-it": "^20.0.1",
    "tsdown": "^0.15.1",
    "typescript": "~5.9.2"
  }
}
